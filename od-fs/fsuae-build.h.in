/*
 * The build's identity, from configure (see FSUAE_VERSION and the variables after it in
 * configure.ac), for the build header (od-fs/fsuae/fsuae-buildinfo.cpp).
 *
 * Generated by configure from fsuae-build.h.in, every time it runs, and only included by
 * fsuae-buildinfo.cpp, so that configuring again rebuilds only that file. configure only lets
 * through values that are safe in C strings.
 *
 * Copyright (c) 2026 Frode Solheim
 * SPDX-License-Identifier: GPL-2.0-or-later
 */

#ifndef OD_FS_FSUAE_BUILD_H
#define OD_FS_FSUAE_BUILD_H

#define FSUAE_VERSION "@FSUAE_VERSION@"
#define FSUAE_BUILD_ORIGIN "@FSUAE_BUILD_ORIGIN@"
#define FSUAE_BUILD_COMMIT "@FSUAE_BUILD_COMMIT@"
#define FSUAE_BUILD_ENVIRONMENT "@FSUAE_BUILD_ENVIRONMENT@"
#define FSUAE_BUILD_DATE "@FSUAE_BUILD_DATE@"

#endif // OD_FS_FSUAE_BUILD_H
