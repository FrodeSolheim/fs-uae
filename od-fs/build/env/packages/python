#!/bin/sh
# --------------------------------------------------------------------------------------------------
set -e
# --------------------------------------------------------------------------------------------------

"$PACKAGE_DEPENDENCY" libffi
"$PACKAGE_DEPENDENCY" libuuid
"$PACKAGE_DEPENDENCY" openssl
"$PACKAGE_DEPENDENCY" sqlite
"$PACKAGE_DEPENDENCY" xz
"$PACKAGE_DEPENDENCY" zlib
"$PACKAGE_DEPENDENCY" zstd

PACKAGE_NAME=python
PACKAGE_VERSION=3.14.10
PACKAGE_REVISION=1
PACKAGE_URL=https://www.python.org/ftp/python/$PACKAGE_VERSION/Python-$PACKAGE_VERSION.tar.xz
PACKAGE_CHECKSUM=de414a57119abef52784d8993e341d53aed635fc2b05c2607d9f98a2c5b72032

# --------------------------------------------------------------------------------------------------
. "$PACKAGE_PRE"
# --------------------------------------------------------------------------------------------------

# In cross mode (setup --host), configure for the triplet, with the build machine's prefix's Python
# (the same version, which setup has made sure of) as the build Python: it runs the build's Python
# scripts and byte-compiles the standard library.
set --
if [ -n "$BUILD_ENV_HOST" ]; then
    set -- --build="$(gcc -dumpmachine)" --host="$BUILD_ENV_HOST" \
        --with-build-python="$BUILD_ENV_BUILD_PREFIX/bin/python${PACKAGE_VERSION%.*}"
fi

tar xf "$PACKAGE_SOURCES/Python-$PACKAGE_VERSION.tar.xz"
cd Python-$PACKAGE_VERSION
# The bundled libmpdec for _decimal, as on Linux (no mpdecimal recipe): without this, configure
# links the first libmpdec it finds, such as Homebrew's (in /usr/local on an Intel Mac, which the
# compiler searches by default).
./configure \
    --prefix="$PACKAGE_PREFIX" \
    --enable-shared \
    --without-static-libpython \
    --disable-test-modules \
    --without-system-libmpdec \
    "$@"
make
make install

# The modules a dist needs (REQUIRED_MODULES in od-fs/build/dist/check.py). Python's build leaves
# out a module whose library configure did not find or could not link, or that did not import
# after the build, with only a line in its output, so check here: otherwise the prefix is made (and
# cached) without it, and only the dist check finds out. On failure, show why from config.log. Not
# in cross mode, where the prefix's Python cannot run.
if [ -z "$BUILD_ENV_HOST" ]; then
    missing=
    for module in _ctypes _hashlib zlib; do
        if ! "$PACKAGE_PREFIX/bin/python${PACKAGE_VERSION%.*}" -c "import $module"; then
            missing="$missing $module"
        fi
    done
    if [ -n "$missing" ]; then
        echo "Error: the Python in $PACKAGE_PREFIX has no$missing" >&2
        echo "What configure found for them (config.log):" >&2
        for module in $missing; do
            grep -n -A1 "checking for stdlib extension module $module\$" config.log >&2 || true
        done
        echo "The OpenSSL checks in config.log:" >&2
        grep -n -A12 -E "Trying link with OPENSSL|checking whether OpenSSL provides" \
            config.log >&2 || true
        ls -l build/lib.*/*_failed.so >&2 2> /dev/null || true
        exit 1
    fi
fi

# --------------------------------------------------------------------------------------------------
. "$PACKAGE_POST"
# --------------------------------------------------------------------------------------------------
