#!/usr/bin/env bash
#
# Build fs-uae.exe in the build directory from WINDOWS_BUILD (default: .build/windows), configuring
# first if needed. Arguments are passed to make (e.g. -j8). See common.sh for the environment
# variables.
#
# Afterwards, the build is laid out like a dist with od-fs/build/windows/dev_layout.py, as native
# builds are (Libs/x86_64-w64-mingw32/ with FS-UAE.exe, the DLLs it needs and FS-UAE._pth, which
# gives Python the quasi-msys2 standard library as Z: paths for Wine): in od-fs for the default
# build, with the proxy as od-fs/FS-UAE.exe, otherwise in the build directory, so other builds (for
# example a path outside .build) do not overwrite od-fs/Libs.

set -e

source "$(dirname "${BASH_SOURCE[0]}")/common.sh"
source "$HERE/quasi-msys2.sh"

setup_quasi_msys2

if [ ! -f "$WINDOWS_BUILD_DIR/Makefile" ]; then
    "$HERE/configure"
fi

(
    windows_env
    make -C "$WINDOWS_BUILD_DIR" "$@"
)

# Lay it out like a dist, as native builds are (see the script): in od-fs for the default build.
layout_args=(--wine "$QUASI_MSYS2_DIR/root/mingw64" "$WINDOWS_BUILD_DIR")
if [ "$WINDOWS_BUILD" = "windows" ]; then
    layout_args+=("$OD_FS_DIR")
fi
python3 "$OD_FS_DIR/build/windows/dev_layout.py" "${layout_args[@]}"
