# Answers for configure checks that cannot run when cross-compiling (configure cannot run a program
# built for the other architecture, or look at the target's /dev). Used by the env system's cross
# mode (od-fs/build/env/setup --host <triplet>), which sets CONFIG_SITE to this file for the env
# recipes and for FS-UAE's own configure. The answers hold for the Linux dists' targets (glibc on
# x86_64 and aarch64).

# Python
ac_cv_buggy_getaddrinfo=no
ac_cv_file__dev_ptmx=yes
ac_cv_file__dev_ptc=no
