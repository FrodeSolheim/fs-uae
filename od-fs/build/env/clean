#!/bin/sh
#
# Deletes the host's env prefix (.build/env/<triplet>, see scripts/paths.sh). The downloaded
# sources are kept.

set -e

BUILD_ENV_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$BUILD_ENV_DIR/scripts/paths.sh"
echo "BUILD_ENV_PREFIX=$BUILD_ENV_PREFIX"

rm -Rf "$BUILD_ENV_PREFIX"
echo "Deleted $BUILD_ENV_PREFIX"
