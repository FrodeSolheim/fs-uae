#!/bin/sh

set -e

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
echo "PROJECT_DIR: $PROJECT_DIR"
cd "$PROJECT_DIR"

# Use FSUAE_BUILD=<name> to configure a separate build directory (default: dev)
BUILD_DIR="$PROJECT_DIR/.build/${FSUAE_BUILD:-dev}"
echo "BUILD_DIR: $BUILD_DIR"

echo
echo Running "$PROJECT_DIR/configure" "$@"
echo

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"
"$PROJECT_DIR/configure" "$@"

# In development mode the binary looks for the Python GUI code and resources relative to its own
# location (SDL_GetBasePath), i.e. <build dir>/od-fs/{python,resources}. Link these to the source
# tree so the binary can be run directly from the build directory.
mkdir -p "$BUILD_DIR/od-fs"
for name in python resources; do
    link="$BUILD_DIR/od-fs/$name"
    if [ -L "$link" ] || [ ! -e "$link" ]; then
        ln -sfn "../../../od-fs/$name" "$link"
    fi
done
