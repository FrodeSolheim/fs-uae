<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Entitlements for the arm64 macOS dist; x86-64 uses entitlements-x86_64.plist.
	     The hardened runtime only allows MAP_JIT memory (used by the 68k JIT and the 86Box
	     x86 dynarec on arm64) with this entitlement. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
