#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

%:
	dh $@ 

# The origin is official only in the maintainer's OBS project (see obs-origin.sh, which deb-src.sh
# copies here).
override_dh_auto_configure:
	dh_auto_configure -- --with-share-dir-name=fs-uae-5 --with-libslirp=system \
		FSUAE_BUILD_ORIGIN="$$(sh debian/obs-origin.sh)" \
		FSUAE_BUILD_ENVIRONMENT="$$(sh debian/obs-origin.sh --build-environment)"

override_dh_auto_install:
	dh_auto_install
	mv debian/fs-uae-5/usr/bin/fs-uae debian/fs-uae-5/usr/bin/fs-uae-5
